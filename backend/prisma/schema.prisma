// ───────────────────────────────────────────────────────────────────
// Impreza · v2 schema · clean rewrite
// ───────────────────────────────────────────────────────────────────
//
//  Domain model (in 60 seconds)
//
//  Country  ──┬── City
//             │
//  User       │     UserAccess (GLOBAL | COUNTRY | CITY)
//   │         └── Inventory  (cityId, color) → count
//   │
//   ├── creates   Transfer  ──── TransferLine (color, sent, received)
//   ├── creates   Expense    (PROMO | LOSS | SHORTAGE | DAMAGE | OTHER)
//   └── trail     AuditLog
//
//  All inventory mutations go through a single transactional path
//  (transfer create / accept / discrepancy resolve / expense create),
//  so balances are never derived from history — they live in the
//  Inventory table and stay in sync via a Prisma $transaction.
//
// ───────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ ENUMS                                                          ║
// ╚═══════════════════════════════════════════════════════════════╝

enum Role {
  ADMIN // global, full power, account management
  OFFICE // global ops, no account management
  COUNTRY // full ops within assigned country/countries; cannot self-reset password
  MANAGER // city-level operations
}

enum AccessScope {
  GLOBAL // everything (admins)
  COUNTRY // every city in one country
  CITY // one specific city
}

enum BraceletColor {
  BLACK
  WHITE
  RED
  BLUE
}

enum TransferStatus {
  PENDING // sent, awaiting acceptance
  ACCEPTED // accepted as-is, balances applied
  REJECTED // refused, no balance change
  DISCREPANCY // received != sent, awaiting resolution
  RESOLVED // discrepancy closed (accepted with shortage written off)
  CANCELLED // sender cancelled before acceptance
}

enum ExpenseKind {
  PROMO // free giveaway
  LOSS // generic loss
  SHORTAGE // auto-created when transfer discrepancy is resolved
  DAMAGE // physically broken
  OTHER
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ACCESS_GRANTED
  ACCESS_REVOKED
  INVENTORY_INTAKE
  TRANSFER_CREATED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_DISCREPANCY
  TRANSFER_RESOLVED
  TRANSFER_CANCELLED
  EXPENSE_CREATED
  EXPENSE_DELETED
  AUTH_LOGIN
  AUTH_LOGOUT
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ GEOGRAPHY                                                      ║
// ╚═══════════════════════════════════════════════════════════════╝

model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO-3166-1 alpha-2 (DE, PL, NL, AT)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities   City[]
  accesses UserAccess[]

  @@index([isActive])
}

model City {
  id        String   @id @default(cuid())
  countryId String
  code      String   @unique // short slug, e.g. "berlin", "warsaw"
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country      Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  inventory    Inventory[]
  transfersOut Transfer[]   @relation("TransferFrom")
  transfersIn  Transfer[]   @relation("TransferTo")
  expenses     Expense[]
  accesses     UserAccess[]

  @@index([countryId])
  @@index([isActive])
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ ACCOUNTS & ACCESS                                              ║
// ╚═══════════════════════════════════════════════════════════════╝

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accesses          UserAccess[]
  transfersCreated  Transfer[]   @relation("TransferCreatedBy")
  transfersAccepted Transfer[]   @relation("TransferAcceptedBy")
  expenses          Expense[]
  auditEvents       AuditLog[]

  @@index([role])
  @@index([isActive])
}

// One row per granted scope. Examples:
//   ADMIN   → 1 row, scope=GLOBAL
//   OFFICE  → N rows, scope=COUNTRY (one per country they manage)
//   MANAGER → N rows, scope=CITY    (one per city they manage)
model UserAccess {
  id        String      @id @default(cuid())
  userId    String
  scope     AccessScope
  countryId String?
  cityId    String?
  createdAt DateTime    @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city    City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  // a single user can't have the same scope twice
  @@unique([userId, scope, countryId, cityId])
  @@index([userId])
  @@index([scope])
  @@index([cityId])
  @@index([countryId])
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ INVENTORY                                                      ║
// ╚═══════════════════════════════════════════════════════════════╝

// Single source of truth for current balance.
// One row per (city, color). Updates always atomic via $transaction.
model Inventory {
  id        String        @id @default(cuid())
  cityId    String
  color     BraceletColor
  count     Int           @default(0)
  updatedAt DateTime      @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, color])
  @@index([color])
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ TRANSFERS                                                      ║
// ╚═══════════════════════════════════════════════════════════════╝

model Transfer {
  id           String         @id @default(cuid())
  code         String         @unique // e.g. TR-2418, generated server-side
  fromCityId   String
  toCityId     String
  status       TransferStatus @default(PENDING)
  comment      String?
  createdById  String
  acceptedById String?
  createdAt    DateTime       @default(now())
  acceptedAt   DateTime?
  resolvedAt   DateTime?
  updatedAt    DateTime       @updatedAt

  fromCity   City  @relation("TransferFrom", fields: [fromCityId], references: [id], onDelete: Restrict)
  toCity     City  @relation("TransferTo", fields: [toCityId], references: [id], onDelete: Restrict)
  createdBy  User  @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("TransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  lines    TransferLine[]
  expenses Expense[] // shortages auto-created when DISCREPANCY → RESOLVED

  @@index([status])
  @@index([fromCityId])
  @@index([toCityId])
  @@index([createdById])
  @@index([createdAt])
}

model TransferLine {
  id            String        @id @default(cuid())
  transferId    String
  color         BraceletColor
  sentCount     Int
  receivedCount Int? // null until accepted

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, color])
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ EXPENSES                                                       ║
// ╚═══════════════════════════════════════════════════════════════╝

model Expense {
  id          String        @id @default(cuid())
  cityId      String
  color       BraceletColor
  count       Int
  kind        ExpenseKind
  reason      String?
  createdById String
  transferId  String? // set for SHORTAGE expenses
  createdAt   DateTime      @default(now())

  city      City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  transfer  Transfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@index([kind])
  @@index([createdAt])
  @@index([transferId])
}

// ╔═══════════════════════════════════════════════════════════════╗
// ║ AUDIT                                                          ║
// ╚═══════════════════════════════════════════════════════════════╝

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  entityType String? // "Transfer" | "Expense" | "User" | …
  entityId   String?
  payload    Json? // diff or context, depends on action
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
