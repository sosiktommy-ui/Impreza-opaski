generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum Role {
  ADMIN
  OFFICE
  USER
}

enum ItemType {
  BLACK
  WHITE
  RED
  BLUE
}

enum TransferStatus {
  SENT
  ACCEPTED
  DISCREPANCY_FOUND
  REJECTED
  CANCELLED
}

enum CityStatus {
  ACTIVE
  LOW
  INACTIVE
}

enum ScopeType {
  GLOBAL
  OFFICE
  CITY
}

enum AccessType {
  FULL    // Can switch into this scope and do everything
  PARTIAL // Can only create external expenses, no scope switch
}

enum ExpenseType {
  INTERNAL
  EXTERNAL
  THIRD
}

enum NotificationType {
  INCOMING_TRANSFER
  ACCEPTANCE_REQUIRED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  DISCREPANCY_ALERT
  LOW_STOCK
  ZERO_STOCK
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  TRANSFER_CREATED
  TRANSFER_SENT
  ACCEPTANCE_SUBMITTED
  DISCREPANCY_DETECTED
  DISCREPANCY_RESOLVED
  TRANSFER_ACCEPTED
  TRANSFER_REJECTED
  TRANSFER_CANCELLED
  INVENTORY_ADJUSTED
  BALANCE_TOPUP
  BALANCE_EDITED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  EXPENSE_CREATED
  EXPENSE_DELETED
  COMPANY_LOSS_RECORDED
  TRANSFER_EDITED
  SCOPE_SELECTED
  SCOPE_SWITCHED
  ACCESS_GRANTED
  ACCESS_REVOKED
  ACCESS_EXPIRED
  BALANCE_ADJUSTED
  EVENT_CREATED
  EVENT_CLOSED
  EVENT_REOPENED
  EXPENSE_REVERSED
  LOGIN_DISABLED_TOGGLED
}

enum ResolutionType {
  ACCEPT_SENDER
  ACCEPT_RECEIVER
  ACCEPT_COMPROMISE
  ACCEPT_AS_IS
  CANCEL_TRANSFER
}

enum ShortageReason {
  SENDER_BLAMED   // Receiver was correct, sender loses
  RECEIVER_BLAMED // Sender was correct, receiver loses
  SPLIT_LOSS      // Both share responsibility
}

// ──────────────────────────────────────────────
// AUTH & USERS
// ──────────────────────────────────────────────

model User {
  id              String  @id @default(uuid())
  email           String? @unique
  username        String  @unique
  passwordHash    String  @map("password_hash")
  passwordVisible String? @map("password_visible")
  role            Role
  displayName     String  @map("display_name")
  isActive        Boolean @default(true) @map("is_active")
  avatarUrl       String? @map("avatar_url")

  // Office scope (for OFFICE role)
  officeId String? @map("office_id")
  office   Office? @relation(fields: [officeId], references: [id])

  // Primary city — home city for USER role.
  // Balance of the city = SUM of all users with this primaryCityId.
  primaryCityId String? @map("primary_city_id")
  primaryCity   City?   @relation("UserPrimaryCity", fields: [primaryCityId], references: [id])

  // Personal balances — source of truth for USER role.
  // ADMIN/OFFICE balances are always 0 (they manage, not carry).
  balanceBlack   Int @default(0) @map("balance_black")
  balanceWhite   Int @default(0) @map("balance_white")
  balanceRed     Int @default(0) @map("balance_red")
  balanceBlue    Int @default(0) @map("balance_blue")
  balanceVersion Int @default(0) @map("balance_version")

  loginDisabled Boolean @default(false) @map("login_disabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  auditLogs             AuditLog[]          @relation("AuditActor")
  acceptanceRecords     AcceptanceRecord[]
  chatMessagesSent      ChatMessage[]       @relation("ChatSender")
  chatMessagesReceived  ChatMessage[]       @relation("ChatReceiver")
  companyLossesResolved CompanyLoss[]
  accesses              UserAccess[]        @relation("AccessHolder")
  accessesGranted       UserAccess[]        @relation("AccessGranter")
  transfersSent         Transfer[]          @relation("TransferFromUser")
  transfersReceived     Transfer[]          @relation("TransferToUser")
  warehouseCreations    WarehouseCreation[] @relation("WarehouseRecipient")
  shortages             Shortage[]
  expensesCreated       Expense[]           @relation("ExpenseCreator")
  adjustments           Adjustment[]        @relation("AdjustmentTarget")

  @@map("users")
}

// ──────────────────────────────────────────────
// SCOPE ACCESS
// ──────────────────────────────────────────────

model UserAccess {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation("AccessHolder", fields: [userId], references: [id], onDelete: Cascade)

  scopeType  ScopeType  @map("scope_type")
  accessType AccessType @default(FULL) @map("access_type")
  scopeId    String?    @map("scope_id") // NULL when GLOBAL; Office.id when OFFICE; City.id when CITY

  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  grantedById String   @map("granted_by_id")
  grantedBy   User     @relation("AccessGranter", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now()) @map("granted_at")
  notes       String?

  @@index([userId])
  @@index([userId, scopeType, scopeId])
  @@index([expiresAt])
  @@map("user_access")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// OFFICES
// ──────────────────────────────────────────────

model Office {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  countries Country[]

  @@map("offices")
}

// ──────────────────────────────────────────────
// GEOGRAPHY
// ──────────────────────────────────────────────

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  latitude  Float    @default(0)
  longitude Float    @default(0)
  officeId  String?  @map("office_id")
  createdAt DateTime @default(now()) @map("created_at")

  office Office? @relation(fields: [officeId], references: [id])
  cities City[]

  @@map("countries")
}

model City {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  status    CityStatus @default(ACTIVE)
  latitude  Float      @default(0)
  longitude Float      @default(0)
  countryId String     @map("country_id")
  country   Country    @relation(fields: [countryId], references: [id])
  createdAt DateTime   @default(now()) @map("created_at")

  // Users whose home city is this city
  primaryUsers User[]    @relation("UserPrimaryCity")
  expenses     Expense[]

  @@unique([countryId, slug])
  @@map("cities")
}

// ──────────────────────────────────────────────
// TRANSFERS (User → User)
// ──────────────────────────────────────────────

model Transfer {
  id String @id @default(uuid())

  fromUserId String @map("from_user_id")
  toUserId   String @map("to_user_id")
  fromUser   User   @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUser     User   @relation("TransferToUser", fields: [toUserId], references: [id])

  status  TransferStatus @default(SENT)
  version Int            @default(0)
  notes   String?

  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  sentAt     DateTime? @map("sent_at")
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by")
  rejectedAt DateTime? @map("rejected_at")
  rejectedBy String?   @map("rejected_by")
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  discrepancyNotes String? @map("discrepancy_notes")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  items             TransferItem[]
  rejection         TransferRejection?
  acceptanceRecords AcceptanceRecord[]
  companyLosses     CompanyLoss[]
  shortages         Shortage[]

  @@index([status])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdBy])
  @@map("transfers")
}

model TransferItem {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemType   ItemType @map("item_type")
  quantity   Int

  @@map("transfer_items")
}

model TransferRejection {
  id         String   @id @default(uuid())
  transferId String   @unique @map("transfer_id")
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  reason     String
  rejectedBy String   @map("rejected_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("transfer_rejections")
}

// ──────────────────────────────────────────────
// ACCEPTANCE (Blind acceptance records)
// ──────────────────────────────────────────────

model AcceptanceRecord {
  id               String   @id @default(uuid())
  transferId       String   @map("transfer_id")
  transfer         Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemType         ItemType @map("item_type")
  sentQuantity     Int      @map("sent_quantity")
  receivedQuantity Int      @map("received_quantity")
  discrepancy      Int      @default(0)
  acceptedById     String   @map("accepted_by_id")
  acceptedBy       User     @relation(fields: [acceptedById], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([transferId, itemType], name: "unique_acceptance_per_item")
  @@index([transferId])
  @@map("acceptance_records")
}

// ──────────────────────────────────────────────
// ADJUSTMENTS (Admin manual corrections — on users)
// ──────────────────────────────────────────────

model Adjustment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation("AdjustmentTarget", fields: [userId], references: [id])
  itemType  ItemType @map("item_type")
  delta     Int
  reason    String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdBy])
  @@map("adjustments")
}

// ──────────────────────────────────────────────
// EXPENSES (Events — creator's balance is deducted)
// ──────────────────────────────────────────────

model Expense {
  id        String      @id @default(uuid())
  cityId    String      @map("city_id")
  city      City        @relation(fields: [cityId], references: [id])
  userId    String      @map("user_id")
  creator   User        @relation("ExpenseCreator", fields: [userId], references: [id])
  eventName String      @map("event_name")
  eventDate DateTime?   @map("event_date")
  location  String?
  type      ExpenseType @default(INTERNAL)
  black     Int         @default(0)
  white     Int         @default(0)
  red       Int         @default(0)
  blue      Int         @default(0)
  notes     String?
  createdBy String      @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([cityId])
  @@index([userId])
  @@index([eventDate])
  @@index([createdBy])
  @@map("expenses")
}

// ──────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ──────────────────────────────────────────────
// AUDIT LOG (IMMUTABLE)
// ──────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String      @map("actor_id")
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// EVENT STORE (CQRS / Event Sourcing)
// ──────────────────────────────────────────────

model DomainEvent {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type")
  version       Int
  payload       Json
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([aggregateId, version])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@index([createdAt])
  @@map("domain_events")
}

// ──────────────────────────────────────────────
// CHAT MESSAGES
// ──────────────────────────────────────────────

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  sender     User     @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String   @map("receiver_id")
  receiver   User     @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([createdAt])
  @@map("chat_messages")
}

// ──────────────────────────────────────────────
// COMPANY LOSSES (Discrepancy resolution losses)
// ──────────────────────────────────────────────

model CompanyLoss {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  transfer   Transfer @relation(fields: [transferId], references: [id])

  black       Int @default(0)
  white       Int @default(0)
  red         Int @default(0)
  blue        Int @default(0)
  totalAmount Int @map("total_amount")

  resolutionType ResolutionType @map("resolution_type")
  resolvedBy     String         @map("resolved_by")
  resolver       User           @relation(fields: [resolvedBy], references: [id])
  resolvedAt     DateTime       @default(now()) @map("resolved_at")

  senderName       String  @map("sender_name")
  receiverName     String  @map("receiver_name")
  originalSent     Int     @map("original_sent")
  originalReceived Int     @map("original_received")
  notes            String?

  @@index([transferId])
  @@index([resolvedBy])
  @@index([resolvedAt])
  @@map("company_losses")
}

// ──────────────────────────────────────────────
// SHORTAGES (Per-user shortage from discrepancy resolution)
// ──────────────────────────────────────────────

model Shortage {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  user       User   @relation(fields: [userId], references: [id])
  transferId String @map("transfer_id")
  transfer   Transfer @relation(fields: [transferId], references: [id])

  black       Int @default(0)
  white       Int @default(0)
  red         Int @default(0)
  blue        Int @default(0)
  totalAmount Int @map("total_amount")

  reason         ShortageReason
  resolutionType ResolutionType @map("resolution_type")
  resolvedBy     String         @map("resolved_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  notes          String?

  @@index([userId])
  @@index([transferId])
  @@index([resolvedBy])
  @@index([createdAt])
  @@map("shortages")
}

// ──────────────────────────────────────────────
// WAREHOUSE CREATION LOG
// Admin/Office assigns bracelets directly to a specific user.
// ──────────────────────────────────────────────

model WarehouseCreation {
  id              String @id @default(uuid())
  recipientUserId String @map("recipient_user_id")
  recipientUser   User   @relation("WarehouseRecipient", fields: [recipientUserId], references: [id])

  black       Int @default(0)
  white       Int @default(0)
  red         Int @default(0)
  blue        Int @default(0)
  totalAmount Int @map("total_amount")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  notes     String?

  @@index([recipientUserId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("warehouse_creations")
}

