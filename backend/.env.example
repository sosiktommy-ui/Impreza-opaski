# --- Required ---
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 64+ char random strings (use openssl rand -hex 64)
JWT_SECRET=replace-me-with-64-char-random-string
REFRESH_SECRET=replace-me-with-different-64-char-random-string

# --- Optional (defaults shown) ---
PORT=3001
BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins (Railway frontend URL).
# *.railway.app is allowed automatically.
FRONTEND_URL=https://your-frontend.up.railway.app
